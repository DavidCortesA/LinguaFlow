{
  "name": "@linguaflow/api",
  "version": "0.1.0",
  "private": true,
  "description": "LinguaFlow REST API (Fastify). Owns business rules and database access.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@linguaflow/ai": "workspace:*",
    "@linguaflow/database": "workspace:*",
    "@linguaflow/learning-engine": "workspace:*",
    "@linguaflow/shared": "workspace:*",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@linguaflow/config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
