# Copy to `.env` and adjust. Placeholders only: never commit real secrets.

# --- PostgreSQL (matches docker-compose.yml) ---
POSTGRES_USER=linguaflow
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=linguaflow
POSTGRES_PORT=5432
DATABASE_URL=postgresql://linguaflow:change-me-locally@localhost:5432/linguaflow

# --- API (apps/api) ---
API_HOST=127.0.0.1
API_PORT=4000
LOG_LEVEL=info
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# --- Web (apps/web) ---
# Base URL of the API as seen from the web app's server and the browser
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- AI (server-side only, not used by the first vertical slice) ---
# Leave empty to use the deterministic mock provider. Real providers may incur
# usage costs. Never expose this value to the browser (no NEXT_PUBLIC_ prefix).
AI_PROVIDER=mock
AI_API_KEY=
