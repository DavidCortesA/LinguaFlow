{
  "name": "linguaflow",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, AI-assisted language-learning platform. Initially Spanish speakers learning English.",
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@linguaflow/web --filter=@linguaflow/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e --filter=@linguaflow/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @linguaflow/database db:generate",
    "db:migrate": "pnpm --filter @linguaflow/database db:migrate",
    "db:studio": "pnpm --filter @linguaflow/database db:studio"
  },
  "devDependencies": {
    "@linguaflow/config": "workspace:*",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "^5.9.0"
  }
}
